# Copy to .env (gitignored). The server reads these at start-up.

# Port the server listens on (ADR 0015).
PORT=8470
# The public address phones use. Shown on the TV with the QR code, and checked against each WebSocket's Origin.
PUBLIC_URL=https://play.303.social
# Extra origins allowed to open a socket (comma-separated), e.g. the LAN address or the Vite dev server.
EXTRA_ORIGINS=http://localhost:5173
# Where the database and media live.
DATA_DIR=./data

# Exact addresses allowed to tell us the visitor's real address (the cloudflared tunnel container), comma-separated.
# Unset: any home-network address is trusted for that (ADR 0015).
TRUSTED_PROXIES=

# The password for /admin (ADR 0015). Without it the admin area stays locked.
ADMIN_PASSWORD=

# AI through OpenRouter (ADR 0011, 0013). Without a key the game still runs on seed content.
OPENROUTER_API_KEY=
# The question generator (admin > Generate): the writer researches on the web and writes; the checker (another family)
# answers blind. Defaults: anthropic/claude-sonnet-5.5 and openai/gpt-5.6-terra. Each batch may spend AI_JOB_BUDGET_USD.
AI_TEXT_MODEL=
AI_CHECK_MODEL=
# House bots in Snake Manor think with this model (talk, votes, night picks). BOT_AI=off keeps them on simple rules.
BOT_MODEL=
BOT_AI=
AI_JOB_BUDGET_USD=1
# Salty's room voices, recorded automatically for newly published questions.
SALTY_VOICES=female=google/gemini-3.8-flash-tts:Laomedeia
AI_IMAGE_MODEL=
AI_VOICE_MODEL=elevenlabs/eleven-v4
AI_VOICE=
